# ==============================================================================
# SPORTCOREOS WEB — ENTORNO QA (VPS / STAGING)
# ==============================================================================
APP_ENV=qa
PORT=80

# Ruta de conexión hacia el backend en la VPS (SportCoreOS QA Stack)
# Vía Nginx Proxy Manager (red npm_network -> http://sportcoreos_qa_api:3000)
API_URL=/api/v1
API_BASE_URL=https://sportcoreos.secticsolar.site
BACKEND_CONTAINER_HOST=sportcoreos_qa_api
BACKEND_CONTAINER_PORT=3000
PUBLIC_DOMAIN=sportcoreos.secticsolar.site
