# ==============================================================================
# SPORTCOREOS WEB — ENTORNO PRODUCCIÓN (VPS / HIGH AVAILABILITY)
# ==============================================================================
APP_ENV=production
PORT=80

# Ruta de conexión hacia el backend en la VPS (SportCoreOS PROD Stack)
# Vía Nginx Proxy Manager (red npm_network -> http://sportcoreos_prod_api:3000)
API_URL=/api/v1
API_BASE_URL=https://app.sportcore.co
BACKEND_CONTAINER_HOST=sportcoreos_prod_api
BACKEND_CONTAINER_PORT=3000
PUBLIC_DOMAIN=app.sportcore.co
