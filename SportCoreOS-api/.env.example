# ==============================================================================
# SPORTCOREOS API - CONFIGURACIÓN DE ENTORNO (.env.example)
# ==============================================================================
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# SEGURIDAD & JWT
JWT_SECRET=CAMBIAR_POR_JWT_SECRET_SEGURO_MINIMO_64_CARACTERES
JWT_EXPIRATION=7d

# BASE DE DATOS POSTGRESQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=sportcore_user
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
DB_NAME=sportcoreos_db

# CONFIGURACIÓN DE RED INTERNA DOCKER
DB_DOCKER_HOST=sportcoreos_db
DB_DOCKER_PORT=5432

# CORS & CLIENTES PERMITIDOS
CORS_ORIGIN=http://localhost:4200,http://localhost:4202

# ALMACENAMIENTO DE ARCHIVOS
UPLOAD_DESTINATION=./uploads
MAX_FILE_SIZE_MB=10

