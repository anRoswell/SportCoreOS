# ==============================================================================
# SPORTCOREOS API - CONFIGURACIÓN DE ENTORNO QA (.env.example)
# ==============================================================================
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# SEGURIDAD & JWT
JWT_SECRET=SportCoreOS_SecretKey_QA_2026_UltraSecureJWT_Sectic
JWT_EXPIRATION=7d

# BASE DE DATOS POSTGRESQL (ENTORNO QA)
DB_HOST=127.0.0.1
DB_PORT=55132
DB_USER=sportcore_user_qa
DB_PASSWORD=SportCoreQA2026*
DB_NAME=sportcoreos_db_qa

# CONFIGURACIÓN DE RED INTERNA DOCKER
DB_DOCKER_HOST=sportcoreos_qa_db
