PORT=3001
NODE_ENV=qa

# Conexión a la Base de Datos dentro de la red Docker QA
# Host interno en red Docker: sportcoreos_qa_db / 5432
# Acceso local host de desarrollo: 127.0.0.1 / 55132
DB_HOST=sportcoreos_qa_db
DB_PORT=5432
DB_USER=sportcore_user_qa
DB_PASSWORD=SportCoreQA2026*
DB_NAME=sportcoreos_db_qa
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Seguridad y Autenticación JWT
JWT_SECRET=mK9$xQ2@vL4%pR7&nT8*jB3#wF5^sY1!zD6(hC0)eG4-aM5+kO2=iU9_SPORTCORE_QA
JWT_EXPIRES_IN=7d

# ========================================================
# FRONTEND WEB — CONFIGURACIÓN QA EN VPS
# ========================================================
# Host interno de backend para Nginx Proxy Manager: sportcoreos_qa_api:3000
# Ruta pública de la API consumida por la SPA: /api/v1
